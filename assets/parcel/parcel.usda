#usda 1.0
(
    defaultPrim = "Parcel"
    metersPerUnit = 1
    upAxis = "Z"
)

# Labeled parcel for the OpenArm flip task.
#
# * /Parcel           — rigid body (RigidBodyAPI; mass/inertia configured by the
#                        Isaac Lab RigidObjectCfg at spawn time).
# * /Parcel/Body      — the box (0.10 x 0.10 x 0.08 m), the only collider.
# * /Parcel/Label     — visual-only "express label" on the local +Z face
#                        (no collision). The local +Z face is the "label face"
#                        the RL task must rotate to point up.
#
# 表面外观：**盒子用纯色**（primvars:displayColor），不绑纹理 —— 纸箱纹理试过几轮，
# 观感反而更假、还容易做出木纹感，最终决定回到纯色。标签仍使用图片纹理
# （express_label.png），由 `mdp/events.py: apply_scene_textures` 在 startup 时
# 统一创建并绑定（材质放在 /World/Looks 下**全局共享**，避免每个环境复制一份）。
#
# UV（primvars:st）依然保留：一是标签的图片纹理需要它，二是将来若要给盒子换回
# 纹理可直接复用，不必再改资产。
#
# 历史坑（已查明）：早先以为"RTX 不认 Cube 上的材质绑定"，其实真正原因是
# **Cube 默认没有 st primvar**——没有 UV，UsdUVTexture 采样失败，表面就渲染成灰/白。
# 补上 st 之后 Cube 也能正常贴图（实测盒面渲染色与纹理均值吻合）。
#
# UV 约定：Cube 的面顺序为 [-Z, +Z, -Y, +Y, -X, +X]，每个面 4 个角，
# 故 st 共 24 个值、interpolation = faceVarying。每个面按"u 沿该面第一坐标轴、
# v 沿第二坐标轴"展开（+Z 面即标签面：u→+X，v→+Y，保证标签图案方向正确）。

def Xform "Parcel" (
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    def Cube "Body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1  # default is 2 (extent -1..1) -> scale would double
        # 尺寸：0.10 (x) x 0.10 (y) x 0.08 (z) m —— 必须与 openarm_flip_env_cfg.PARCEL_SIZE 一致
        float3 xformOp:scale = (0.10, 0.10, 0.08)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        color3f[] primvars:displayColor = [(0.66, 0.45, 0.24)]  # kraft brown（盒子就用这个纯色）
        # 6 面 x 4 角 = 24 个 UV
        texCoord2f[] primvars:st = [
            (1, 0), (0, 0), (0, 1), (1, 1),   # -Z
            (0, 0), (0, 1), (1, 1), (1, 0),   # +Z
            (0, 0), (0, 1), (1, 1), (1, 0),   # -Y
            (1, 0), (0, 0), (0, 1), (1, 1),   # +Y
            (0, 0), (0, 1), (1, 1), (1, 0),   # -X
            (1, 0), (1, 1), (0, 1), (0, 0),   # +X
        ] (
            interpolation = "faceVarying"
        )
    }

    def Cube "Label"
    {
        double size = 1
        # xformOpOrder = [scale, translate] composes as M = S * T: the translate
        # is applied in the pre-scale frame and multiplied by the z-scale, so
        # 80.4 * 0.0005 = 0.0402 m -> label center just above the box top face
        # (box half height 0.08/2 = 0.04, +0.2 mm gap).
        # 标签面积按盒子放大比例同比缩放（原来 0.078x0.048 在 0.09 面上，
        # 占面宽 87% / 53% -> 在 0.10 面上为 0.0867 x 0.0533），保证画面里
        # 标签像素占比与之前一致。
        float3 xformOp:scale = (0.0867, 0.0533, 0.0005)
        double3 xformOp:translate = (0, 0, 80.4)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        color3f[] primvars:displayColor = [(1.0, 1.0, 1.0)]  # fallback colour
        # 可见面是 +Z（标签朝上那面）；UV 同样 6 面 x 4 角
        texCoord2f[] primvars:st = [
            (1, 0), (0, 0), (0, 1), (1, 1),   # -Z
            (0, 0), (0, 1), (1, 1), (1, 0),   # +Z（标签面：u→+X, v→+Y）
            (0, 0), (0, 1), (1, 1), (1, 0),   # -Y
            (1, 0), (0, 0), (0, 1), (1, 1),   # +Y
            (0, 0), (0, 1), (1, 1), (1, 0),   # -X
            (1, 0), (1, 1), (0, 1), (0, 0),   # +X
        ] (
            interpolation = "faceVarying"
        )
    }
}
